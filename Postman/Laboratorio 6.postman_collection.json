  "item": [
    {
      "name": "Libros",
      "item": [
        {
          "name": "Registrar libro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Cien años de soledad\",\n  \"autor\": \"Gabriel García Márquez\",\n  \"isbn\": \"9780307474728\",\n  \"anioPublicacion\": 1967,\n  \"estado\": \"DISPONIBLE\"\n}"
            },
            "url": "{{baseUrl}}/api/libros"
          }
        },
        { "name": "Consultar libros", "request": { "method": "GET", "url": "{{baseUrl}}/api/libros" } },
        { "name": "Consultar por título", "request": { "method": "GET", "url": "{{baseUrl}}/api/libros/titulo/Cien%20a%C3%B1os%20de%20soledad" } },
        {
          "name": "Actualizar libro",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Cien años de soledad\",\n  \"autor\": \"Gabriel García Márquez\",\n  \"isbn\": \"9780307474728\",\n  \"anioPublicacion\": 1967,\n  \"estado\": \"PRESTADO\"\n}"
            },
            "url": "{{baseUrl}}/api/libros/1"
          }
        },
        { "name": "Eliminar libro", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/libros/1" } }
      ]
    },
    {
